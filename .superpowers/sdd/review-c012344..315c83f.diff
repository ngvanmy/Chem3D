+pub fn get_db_path(app_handle: &tauri::AppHandle) -> PathBuf {
+    let mut path = app_handle.path().app_data_dir().unwrap_or_else(|_| PathBuf::from("."));
+    fs::create_dir_all(&path).ok();
+    path.push("chem3d.db");
+    path
